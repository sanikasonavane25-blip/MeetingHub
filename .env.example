# Copy to .env and fill in. Never commit .env.
# AI provider: anthropic | openai | gemini | none  (none = rule-based fallback only)
AI_PROVIDER=anthropic
AI_API_KEY=
# anthropic example: claude-sonnet-5-5   |  openai example: gpt-4o-mini
AI_MODEL=claude-sonnet-5-5
AI_TIMEOUT_SECONDS=30
AI_RETRIES=1

LOG_LEVEL=INFO
STALL_DAYS=5
SEED_DEMO_DATA=true
